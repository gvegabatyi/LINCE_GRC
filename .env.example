# Lince GRC — plantilla de variables de entorno para DESARROLLO LOCAL (sin claves).
# Copiar a .env (excluido de git). Todo queda accesible sólo desde este equipo
# (127.0.0.1), por eso no se usan contraseñas.

# --- PostgreSQL local (docker compose lee estas variables de este mismo .env) ---
POSTGRES_USER=postgres
POSTGRES_DB=lince_grc
POSTGRES_PORT=5432
# Sólo este equipo. No exponer a la red con autenticación trust.
POSTGRES_BIND=127.0.0.1
# trust = sin contraseña (sólo desarrollo local). Servidor compartido: scram-sha-256
# + POSTGRES_PASSWORD fuerte + contraseña en DATABASE_URL.
POSTGRES_HOST_AUTH_METHOD=trust

# --- Conexión de la app (obligatoria) ------------------------------------------
# Neon/Railway: usar la URL del proveedor (con credenciales) y ?sslmode=require
DATABASE_URL=postgresql://postgres@localhost:5432/lince_grc

# --- Acceso a la app -----------------------------------------------------------
# false = sin pantalla de login (desarrollo local; Streamlit escucha sólo en 127.0.0.1).
# En cualquier despliegue accesible por red: true + LINCE_ACCESS_PASSWORD.
LINCE_AUTH_ENABLED=false
# LINCE_ACCESS_PASSWORD=

# --- Copiloto normativo (opcional, addons/normativa) -----------------------------
# desactivado | anthropic | ollama
LINCE_COPILOTO_PROVEEDOR=desactivado
# Por defecto: claude-opus-5-5 (anthropic) / llama3.1 (ollama)
# LINCE_COPILOTO_MODELO=
# Sólo con proveedor anthropic (requiere: pip install -r addons/normativa/requirements-copiloto.txt)
# ANTHROPIC_API_KEY=
# Sólo con proveedor ollama
# OLLAMA_URL=http://localhost:11434
