# Lince GRC — plantilla de variables de entorno.
# Copiar a .env (excluido de git) y completar. Nunca versionar .env con valores reales.

# --- PostgreSQL local (docker compose lee estas variables de este mismo .env) ---
# Se aplican al crear el volumen por primera vez; cambiarlas después no altera
# la contraseña de una BD ya inicializada.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR
POSTGRES_DB=lince_grc
POSTGRES_PORT=5432

# --- Conexión de la app (obligatoria) ------------------------------------------
# Local: debe coincidir con las variables POSTGRES_* de arriba.
# Neon/Railway: usar la URL del proveedor y agregar ?sslmode=require
DATABASE_URL=postgresql://postgres:CAMBIAR@localhost:5432/lince_grc

# --- Acceso (barrera temporal de desarrollo) -------------------------------------
# true por defecto. Con true, LINCE_ACCESS_PASSWORD es obligatoria.
# No desactivar en equipos accesibles desde la red.
LINCE_AUTH_ENABLED=true
LINCE_ACCESS_PASSWORD=CAMBIAR

# --- Copiloto normativo (opcional, addons/normativa) -----------------------------
# desactivado | anthropic | ollama
LINCE_COPILOTO_PROVEEDOR=desactivado
# Por defecto: claude-opus-5-5 (anthropic) / llama3.1 (ollama)
# LINCE_COPILOTO_MODELO=
# Sólo con proveedor anthropic (requiere: pip install -r addons/normativa/requirements-copiloto.txt)
# ANTHROPIC_API_KEY=
# Sólo con proveedor ollama
# OLLAMA_URL=http://localhost:11434
